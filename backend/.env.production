APP_NAME=ClinicFlow API
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=https://clinicflow.example.com
DATABASE_URL=postgresql+asyncpg://clinicflow:REPLACE_ME@db:5432/clinicflow
LOG_LEVEL=INFO
JWT_SECRET=REPLACE_WITH_SECURE_SECRET
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30
