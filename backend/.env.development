APP_NAME=ClinicFlow API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://clinicflow:clinicflow@localhost:5432/clinicflow
LOG_LEVEL=DEBUG
JWT_SECRET=development-only-change-before-production
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30
